<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>French Atelier | Explore Courses</title>
<style>body{font:16px/1.5 Arial,sans-serif;color:#20242a;background:white;max-width:1000px;margin:auto;padding:0 18px 50px}header{position:sticky;top:0;background:white;padding:12px 0;border-bottom:1px solid #d4d7dc}button{font:600 15px Arial;background:#223247;color:#fff;border:0;border-radius:5px;padding:12px 18px;cursor:pointer}#msg{font-size:14px;margin-left:10px}article{margin-top:24px}section{overflow-x:auto}td,th{overflow-wrap:break-word}a{color:#225a87}</style></head>
<body><header><button id="copy">Copy formatted email</button><span role="status" id="msg"></span></header><article id="mail">
$body$
</article><script>
const area=document.querySelector('#mail'), msg=document.querySelector('#msg');
for(const t of area.querySelectorAll('table')){
 t.style.cssText='border-collapse:collapse;width:100%;font:14px/1.45 Arial,sans-serif;color:#20242a;margin:12px 0 24px';
 t.querySelectorAll('colgroup').forEach(c=>c.remove());
 for(const c of t.querySelectorAll('th,td'))c.style.cssText='border:1px solid #ccd2d8;padding:8px 10px;vertical-align:top;text-align:left;'+(c.tagName==='TH'?'background-color:#edf0f3;font-weight:bold;':'');
 const frame=document.createElement('section');t.before(frame);frame.appendChild(t);
}
for(const h of area.querySelectorAll('h2'))h.style.cssText='font:bold 22px Arial,sans-serif;margin:24px 0 10px';
function selectMail(){const range=document.createRange();range.selectNodeContents(area);const sel=getSelection();sel.removeAllRanges();sel.addRange(range)}
document.querySelector('#copy').onclick=async()=>{
 const html='<div style="font:15px/1.5 Arial,sans-serif;color:#20242a">'+area.innerHTML+'</div>';
 try{await navigator.clipboard.write([new ClipboardItem({'text/html':new Blob([html],{type:'text/html'}),'text/plain':new Blob([area.innerText],{type:'text/plain'})})]);msg.textContent='Copied. Paste into your email.'}
 catch{selectMail();let ok=false;try{ok=document.execCommand('copy')}catch{}msg.textContent=ok?'Copied. Paste into your email.':'Email selected. Press Ctrl+C or ⌘C to copy.'}
};
</script></body></html>
